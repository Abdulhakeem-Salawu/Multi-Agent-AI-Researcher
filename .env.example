# Web search provider
TAVILY_API_KEY=

# Any OpenAI-compatible chat completion endpoint (Ollama, vLLM, LM Studio, hosted APIs)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_MODEL=gemma3:1b
REQUEST_TIMEOUT_SECONDS=45

# Research controls
MAX_RESEARCH_QUERIES=4
MAX_RESULTS_PER_QUERY=8
MAX_EVIDENCE_SOURCES=8
MAX_RESEARCH_ROUNDS=1
RETRIEVAL_MODE=hybrid
RESEARCH_DB_PATH=data/research_runs.sqlite3

# Observability (install with: pip install -e ".[observability]")
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PROMPT_MANAGEMENT_ENABLED=false
LANGFUSE_PROMPT_LABEL=production
# Research content is excluded from traces by default.
LANGFUSE_TRACE_CONTENT=false

# OpenTelemetry OTLP/HTTP exporter (optional)
OTEL_SERVICE_NAME=multi-agent-ai-researcher
OTEL_EXPORTER_OTLP_ENDPOINT=
# Example: http://localhost:4318

# Prometheus metrics are exposed at GET /metrics when prometheus-client is installed.
